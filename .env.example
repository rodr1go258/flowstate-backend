# =============================================================================
# VARIABLES DE ENTORNO - FlowState
# =============================================================================
# Copia este archivo a .env.local y rellena con tus valores reales
# NUNCA commitees .env.local a Git

# ─────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (InsForge PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos
# Obtén desde: https://dashboard.insforge.app -> tu proyecto -> Connection strings
DATABASE_URL=postgresql://user:password@host:5432/flowstate

# ─────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN JWT
# ─────────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres)
# Genera una: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_de_32_caracteres_minimo_aqui

# TTL para tokens de acceso (formato Go duration)
ACCESS_TTL=15m

# TTL para tokens de refresh (formato Go duration)
REFRESH_TTL=168h

# ─────────────────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────────────────
# Puerto en el que escucha el servidor Go
PORT=8080

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# Ambiente: dev, staging, production
ENV=dev

# CORS: orígenes permitidos separados por coma
# En producción: https://tudominio.com,https://app.tudominio.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# OAUTH - GOOGLE
# ─────────────────────────────────────────────────────────────────────────
# Obtén desde: https://console.cloud.google.com -> tu proyecto -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────────────
# INTEGRACIONES - OpenRouter (IA)
# ─────────────────────────────────────────────────────────────────────────
# Obtén desde: https://openrouter.ai -> Settings -> API Key
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Modelo a usar (ver disponibles en https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# =============================================================================
# VARIABLES PARA DESARROLLO LOCAL (Next.js frontend)
# =============================================================================
# Coloca estos en apps/web/.env.local

# URL del backend API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Opcional: variables de análisis, etc.
# NEXT_PUBLIC_SENTRY_DSN=...
